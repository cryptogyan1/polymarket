# ========================================
# Polymarket Trading Bot Configuration
# ========================================
# Copy this file to `.env` and fill required secrets.
# All values here are SAFE DEFAULTS / examples.

# ========================================
# WALLET CONFIGURATION (REQUIRED)
# ========================================
# PRIVATE_KEY: EOA private key used for signing (required)
PRIVATE_KEY=
# PROXY_WALLET: Polymarket proxy/funder wallet (required)
PROXY_WALLET=
# RPC_URL: Polygon RPC endpoint used by Rust bot (required)
RPC_URL=
# POLYGON_RPC_URL: optional alias used by some external scripts/tools (not required by Rust core)
POLYGON_RPC_URL=
# CHAIN_ID: Polygon mainnet = 137 (default in executor if unset)
CHAIN_ID=137

# ========================================
# POSITION SIZING MODE
# ========================================
# TRADE_MODE options: PERCENTAGE (default), DYNAMIC, FREE, FIXED
TRADE_MODE=PERCENTAGE
# FIXED mode only: total USDC budget per paired trade intent
FIXED_USDC_PER_TRADE=5
# PERCENTAGE mode only: % of wallet balance to allocate
PERCENTAGE_PER_TRADE=10
# DYNAMIC mode only: risk cap (%) for adaptive sizing formula
MAX_RISK_PERCENT=1

# ========================================
# POLYMARKET API CREDENTIALS (REQUIRED)
# ========================================
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
# POLY_SIGNATURE_TYPE: common values are 0 (EOA) or 2 (proxy/funder setup)
POLY_SIGNATURE_TYPE=2

# ========================================
# EXECUTION MODE
# ========================================
# executor (recommended) or direct
EXECUTION_MODE=executor
# Local python executor URL when EXECUTION_MODE=executor
EXECUTOR_URL=http://127.0.0.1:8787

# ========================================
# SAFETY + LOGGING
# ========================================
# READ_ONLY=true will block order placement
READ_ONLY=false
# Rust log level: info|debug|warn|error
RUST_LOG=info
# Optional log file path for full timestamped logs (terminal stays minimal)
LOG_FILE=logs/bot.log
# Rejection-only logs are written here (kept out of terminal for cleaner output)
REJECTED_LOG_FILE=Rejected_logs.log

# Optional spend floor/ceiling used by config helpers (defaults: 1.0 / 100.0)
# MIN_TRADE_SIZE=1.0
# MAX_TRADE_SIZE=100.0

# ========================================
# ARBITRAGE FILTERS / PRICE MODEL
# ========================================
# Maximum combined pair price BEFORE fee/slippage tolerance logic
# Code default if unset: 0.978
ARBITRAGE_MAX_SUM=0.978
# Additional tolerance above ARBITRAGE_MAX_SUM for detection/rebalance checks
# Code default if unset: 0.02
ARBITRAGE_SUM_TOLERANCE=0.012
# Reject opportunities where both legs are too cheap/too expensive
MIN_REASONABLE_PRICE=0.20
MAX_REASONABLE_PRICE=0.90
# Reject opportunities with suspiciously low raw total
MIN_TOTAL_COST=0.60
# Fee/slippage used in effective cost checks
# TRADE_FEE_BPS default: 100
# SLIPPAGE_BPS default: 35
TRADE_FEE_BPS=100
SLIPPAGE_BPS=35

# ========================================
# ORDER SIZING / SHARE LIMITS
# ========================================
# Sports mode (when true, bot auto-discovers ALL currently live sports markets and tracks them)
SPORTS_MOD=false
# Optional refresh cadence (seconds) for rebuilding the live market set
SPORTS_REFRESH_SECS=60
# Optional cap on number of concurrent live sports markets
SPORTS_MAX_MARKETS=100

# BTC-only 5-minute mode (when true, ignores cross-pair toggles below)
BTC_5_MIN=false
# In BTC_5_MIN mode, arb gate remains: effective_total_cost <= ARBITRAGE_MAX_SUM + ARBITRAGE_SUM_TOLERANCE
# Example strict cap: ARBITRAGE_MAX_SUM=0.95 and ARBITRAGE_SUM_TOLERANCE=0.00
# Cross-pair selection (enable exactly one when BTC_5_MIN=false)
PAIR_BTC_ETH=true
PAIR_BTC_SOL=false
PAIR_BTC_XRP=false
# Legacy aliases also supported: BTC_ETH/BTC_SOL/BTC_XRP or BTC-ETH/BTC-SOL/BTC-XRP
# Minimum shares per leg (Rust + executor enforce this)
MIN_SHARES=5
# Optional max shares per leg cap
MAX_SHARES=5
# When true and MIN_SHARES == MAX_SHARES, executor enforces exact fixed share size
STRICT_SHARE_BOUNDS=true
# When true, Rust can auto-bump units to MIN_SHARES if affordable/liquid
AUTO_BUMP_MIN_SHARES=false
# Per market-condition exposure cap in tracked state
MAX_TOTAL_SHARES_PER_MARKET=5
# Max completed paired trades per direction per market window (0 = unlimited)
MAX_TRADES_PER_DIRECTION_PER_WINDOW=1

# ========================================
# EXECUTOR BEHAVIOR
# ========================================
# FOK applies globally (typically false so SELL cashouts can rest if needed)
FOK=false
# FOK_BUY applies Fill-or-Kill only to BUY orders
FOK_BUY=true
# Retry count for paired submission loop in Rust executor mode
# NOTE: value is clamped to min 1 in code, so 0 behaves as 1
EXECUTOR_RETRY_ATTEMPTS=1
# If second leg fails, retry with +N cents price bump
SECOND_LEG_PRICE_BUMP_CENTS=2
# If true, allows continuing after incomplete pair (not recommended)
ALLOW_PARTIAL_ARB=false
# Telegram notifications for fills/partials/unwinds (executor)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram manual control bot (executor/telegram_control_bot.py)
# Uses dedicated RPC for CLAIM operations (fallback to RPC_URL when unset)
TELEGRAM_CONTROL_RPC_URL=
# Optional CLAIM-specific wallet override. Useful when trading via proxy/delegate setup.
# redeemPositions must be signed by the wallet that directly holds the conditional tokens.
CLAIM_WALLET=
# Optional CLAIM-specific signer key (used before PRIVATE_KEY)
CLAIM_PRIVATE_KEY=

# ========================================
# MONITOR SPEED / DATA FEEDS
# ========================================
# Suppress duplicate opportunities for this many ms
OPPORTUNITY_DEDUPE_MS=1000

# Polling interval for snapshot loop in milliseconds
# Env override takes precedence over config.json
CHECK_INTERVAL_MS=250
# Enable background websocket that updates in-memory PriceCache
ENABLE_WS_CACHE=true
# Max cache age (ms) before monitor falls back to REST fetch
PRICE_CACHE_MAX_AGE_MS=100

# ========================================
# CIRCUIT BREAKER
# ========================================
# If enabled, bot pauses processing after too many recent failures
CIRCUIT_BREAKER_ENABLED=true
# Failures allowed within window before breaker trips
CIRCUIT_BREAKER_MAX_FAILURES=10
# Circuit breaker rolling window in seconds
CIRCUIT_BREAKER_WINDOW_SECS=3600

# ========================================
# EXPERIMENTAL TOGGLES
# ========================================
# If true, scales units by opportunity edge factor in sizing function
ADAPTIVE_POSITION_SIZING=false
# If true, currently only logs future smart-routing path (no deep split-routing yet)
SMART_ORDER_ROUTING=false

# ========================================
# OPTIONAL CONTRACT OVERRIDE
# ========================================
# Polygon USDC default
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
